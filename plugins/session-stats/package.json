{
  "name": "@xiechenghua01/dsh-session-stats",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "description": "Session statistics panel for the DeepSeek Harness Web GUI: token usage, session counts, estimated cost and budget, per-session usage, CPU/runtime and log footprint.",
  "license": "MIT",
  "author": "xiechenghua01",
  "homepage": "https://github.com/xiechenghua01/dsh-plugins/tree/main/plugins/session-stats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechenghua01/dsh-plugins.git",
    "directory": "plugins/session-stats"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
