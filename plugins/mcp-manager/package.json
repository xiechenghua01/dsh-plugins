{
  "name": "@chengze/dsh-mcp-manager",
  "version": "0.8.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "MCP server manager for the DeepSeek Harness Web GUI: a profile-scoped Settings list with search, refresh, registered tool details, server configuration, enable/disable and connectivity tests. Form and JSON editing use an editor that covers the host Settings panel.",
  "license": "MIT",
  "author": "xiechenghua01",
  "homepage": "https://github.com/xiechenghua01/dsh-plugins/tree/main/plugins/mcp-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechenghua01/dsh-plugins.git",
    "directory": "plugins/mcp-manager"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "CONTRACT.md",
    "index.js",
    "lib/*.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
