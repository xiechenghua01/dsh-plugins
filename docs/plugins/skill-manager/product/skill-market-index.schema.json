{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiechenghua01/dsh-plugins/main/docs/plugins/skill-manager/product/skill-market-index.schema.json",
  "title": "DSH Skill Market Index",
  "description": "Skill market index format 1. Structural schema only; semantic rules (URL credentials/fragments, unique names/versions, total sizes, frontmatter, redirects) are enforced by the reference validator. Unknown members are ignored by readers.",
  "type": "object",
  "required": ["format", "title", "skills"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "format": { "const": 1 },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "homepage": { "$ref": "#/$defs/url" },
    "repository": { "$ref": "#/$defs/url" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "icon": { "$ref": "#/$defs/icon" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "skills": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "languageId": {
      "type": "string",
      "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{1,8})*$"
    },
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 500 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 20,
          "required": ["en"],
          "propertyNames": { "$ref": "#/$defs/languageId" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$"
    },
    "icon": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^data:image/(svg\\+xml|png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
        },
        { "$ref": "#/$defs/url" },
        { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\s]+$" }
      ]
    },
    "declaration": {
      "type": "object",
      "required": ["title"],
      "properties": { "title": { "$ref": "#/$defs/localizedText" } },
      "additionalProperties": true
    },
    "sortKeyDeclaration": {
      "type": "object",
      "required": ["title", "order"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "order": { "enum": ["asc", "desc"] }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "categories": { "type": "object", "additionalProperties": { "$ref": "#/$defs/declaration" } },
        "labels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/declaration" } },
        "sortKeys": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sortKeyDeclaration" } }
      },
      "additionalProperties": true
    },
    "skillMetadata": {
      "type": "object",
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "keywords": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sortKeys": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "filePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*(/[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*)*$"
    },
    "file": {
      "type": "object",
      "required": ["path", "url", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/filePath" },
        "url": { "$ref": "#/$defs/url" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      },
      "additionalProperties": true
    },
    "gitSource": {
      "type": "object",
      "required": ["type", "url", "commit"],
      "properties": {
        "type": { "const": "git" },
        "url": { "$ref": "#/$defs/url" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "$ref": "#/$defs/filePath" }
      },
      "additionalProperties": true
    },
    "engines": {
      "type": "object",
      "properties": { "dsh": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "additionalProperties": true
    },
    "version": {
      "type": "object",
      "required": ["version", "publishTimestamp", "files"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "publishTimestamp": { "type": "integer", "minimum": 0, "maximum": 99999999999 },
        "engines": { "$ref": "#/$defs/engines" },
        "source": { "$ref": "#/$defs/gitSource" },
        "yanked": { "type": "boolean" },
        "readme": { "$ref": "#/$defs/url" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/file" },
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "const": "SKILL.md" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "additionalProperties": true
    },
    "skill": {
      "type": "object",
      "required": ["name", "description", "versions"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "license": { "type": "string", "minLength": 1, "maxLength": 64 },
        "homepage": { "$ref": "#/$defs/url" },
        "repository": { "$ref": "#/$defs/url" },
        "icon": { "$ref": "#/$defs/icon" },
        "metadata": { "$ref": "#/$defs/skillMetadata" },
        "deprecated": { "type": "boolean" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/version" }
        }
      },
      "additionalProperties": true
    }
  }
}